# Safe input handling using try-except
try:
    age = int(input('Enter your Age: '))
except ValueError:
    print('Please enter a valid number for Age.')
    exit()

if age < 0:
    print('Age cannot be negative.')
    exit()

ticket_type = input('Enter Ticket Type (Regular or VIP): ')
points = 100
is_active = True  # Agar yeh fixed hai toh aap isay condition mein direct use kar sakte hain

# Optimized conditional check
if age < 18 and ticket_type == 'VIP' and is_active:
    print('Yes Eligible')
    points += 50
    print(f"Updated Points: {points}")
else:
    print('Not Eligible')